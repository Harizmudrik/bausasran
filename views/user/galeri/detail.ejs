<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= groupFoto.Nama || 'Album' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/globals.css">

    <style>
        /* Custom Styles untuk Scrollbar dan Animasi Halus */
        .hide-scroll::-webkit-scrollbar {
            display: none;
        }
        .hide-scroll {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        
        /* Animasi Masuk */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
            animation: fadeInUp 0.5s ease-out forwards;
        }
        
        /* Glass Effect */
        .glass-panel {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
    </style>
</head>
<body class="flex bg-slate-50 font-sans text-slate-800">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 p-6 md:p-10 h-screen overflow-y-auto">
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-8 animate-fade-in-up" style="animation-delay: 0.1s;">
            <a href="/user/galeri" class="inline-flex items-center px-4 py-2 bg-white text-slate-600 rounded-full shadow-sm hover:shadow-md hover:text-blue-600 transition-all duration-300 group">
                <svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Kembali ke Galeri
            </a>
        </div>

        <div class="glass-panel rounded-2xl shadow-xl p-8 border border-white/50 animate-fade-in-up" style="animation-delay: 0.2s;">
            <div class="border-b border-slate-200 pb-6 mb-8 flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-800 to-slate-600 mb-2">
                        <%= groupFoto.Nama || 'Album Tanpa Nama' %>
                    </h1>
                    <p class="text-slate-500 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <%= groupFoto.dataValues.fotoFiles.length %> Foto
                    </p>
                </div>
            </div>

            <% if (groupFoto.dataValues.fotoFiles && groupFoto.dataValues.fotoFiles.length > 0) { %>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
                    <% groupFoto.dataValues.fotoFiles.forEach((foto, index) => { %>
                        <div class="group relative aspect-square cursor-zoom-in rounded-xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 animate-fade-in-up" 
                             style="animation-delay: <%= 0.3 + (index * 0.05) %>s"
                             onclick="openLightbox('<%= foto.Foto %>')">
                            
                            <img src="/images/galeri/<%= foto.Foto %>" 
                                 alt="Foto Galeri"
                                 loading="lazy"
                                 class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-in-out">
                            
                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
                                <div class="opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-300">
                                    <span class="bg-white/90 text-slate-900 p-3 rounded-full shadow-lg backdrop-blur-sm">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                                    </span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-20 bg-slate-50 rounded-xl border border-dashed border-slate-300">
                    <div class="bg-white p-4 rounded-full inline-block shadow-sm mb-4">
                        <svg class="h-10 w-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <p class="text-slate-500 font-medium">Belum ada foto dalam album ini.</p>
                </div>
            <% } %>
        </div>
    </main>

    <div id="lightbox" class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-300" aria-hidden="true">
        
        <div class="absolute inset-0 bg-black/90 backdrop-blur-md transition-opacity" onclick="closeLightbox()"></div>

        <div class="relative z-10 w-full h-full flex items-center justify-center p-4">
            
            <button onclick="closeLightbox()" class="absolute top-6 right-6 z-20 text-white/70 hover:text-white bg-black/20 hover:bg-white/20 p-2 rounded-full transition-all backdrop-blur-sm">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>

            <button onclick="prevImage(event)" class="absolute left-4 md:left-8 z-20 text-white/70 hover:text-white bg-black/20 hover:bg-white/20 p-3 rounded-full transition-all backdrop-blur-sm group">
                <svg class="w-8 h-8 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </button>

            <div class="relative flex flex-col items-center max-w-7xl w-full">
                <img id="lightbox-img" src="" alt="Preview" 
                     class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl transition-all duration-500 opacity-0 scale-95 select-none">
                
                <div id="loading-spinner" class="absolute inset-0 flex items-center justify-center z-[-1]">
                    <div class="animate-spin rounded-full h-12 w-12 border-4 border-white border-t-transparent"></div>
                </div>

                <div class="mt-4 px-6 py-2 bg-black/50 backdrop-blur-md rounded-full text-white text-sm font-medium tracking-wide">
                    Foto <span id="current-index" class="text-blue-400">1</span> dari <span id="total-images"><%= groupFoto.dataValues.fotoFiles.length %></span>
                </div>
            </div>

            <button onclick="nextImage(event)" class="absolute right-4 md:right-8 z-20 text-white/70 hover:text-white bg-black/20 hover:bg-white/20 p-3 rounded-full transition-all backdrop-blur-sm group">
                <svg class="w-8 h-8 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
        </div>
    </div>

    <script>
        // Data Foto dari Server
        const fotoList = [
            <% for(let foto of groupFoto.dataValues.fotoFiles) { %>
                '<%= foto.Foto %>',
            <% } %>
        ];
        
        let currentIndex = 0;
        const lightbox = document.getElementById('lightbox');
        const imgElement = document.getElementById('lightbox-img');
        const spinner = document.getElementById('loading-spinner');

        function openLightbox(foto) {
            currentIndex = fotoList.indexOf(foto);
            
            // Tampilkan lightbox container dulu
            lightbox.classList.remove('hidden');
            // Sedikit delay agar transisi CSS opacity bekerja
            requestAnimationFrame(() => {
                lightbox.classList.remove('opacity-0');
            });
            
            // Kunci scroll body
            document.body.style.overflow = 'hidden';
            
            loadImage(foto);
        }

        function closeLightbox() {
            // Fade out
            lightbox.classList.add('opacity-0');
            
            // Kembalikan scroll body
            document.body.style.overflow = 'auto';

            // Tunggu animasi selesai baru hide display
            setTimeout(() => {
                lightbox.classList.add('hidden');
                // Reset image state
                imgElement.src = '';
                imgElement.classList.add('opacity-0', 'scale-95');
            }, 300);
        }

        function loadImage(filename) {
            // Efek transisi gambar: sembunyikan gambar lama
            imgElement.classList.add('opacity-0', 'scale-95');
            spinner.classList.remove('hidden'); // Show spinner

            const newSrc = '/images/galeri/' + filename;

            // Preload image object untuk memastikan load selesai baru ditampilkan
            const tempImg = new Image();
            tempImg.src = newSrc;
            
            tempImg.onload = () => {
                imgElement.src = newSrc;
                document.getElementById('current-index').textContent = currentIndex + 1;
                
                // Tampilkan gambar baru dengan animasi
                requestAnimationFrame(() => {
                    spinner.classList.add('hidden');
                    imgElement.classList.remove('opacity-0', 'scale-95');
                });
            };
        }

        function prevImage(event) {
            if(event) event.stopPropagation();
            currentIndex = (currentIndex - 1 + fotoList.length) % fotoList.length;
            loadImage(fotoList[currentIndex]);
        }

        function nextImage(event) {
            if(event) event.stopPropagation();
            currentIndex = (currentIndex + 1) % fotoList.length;
            loadImage(fotoList[currentIndex]);
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (!lightbox.classList.contains('hidden')) {
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowLeft') prevImage();
                if (e.key === 'ArrowRight') nextImage();
            }
        });
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galeri Foto</title>
    
    <style>
        /* Custom CSS untuk animasi halus */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .animate-card {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0; /* Mulai invisible */
        }

        /* Staggered delay loop untuk kartu (sampai 10 item pertama) */
        .animate-card:nth-child(1) { animation-delay: 0.1s; }
        .animate-card:nth-child(2) { animation-delay: 0.15s; }
        .animate-card:nth-child(3) { animation-delay: 0.2s; }
        .animate-card:nth-child(4) { animation-delay: 0.25s; }
        .animate-card:nth-child(5) { animation-delay: 0.3s; }
        /* dst... */
    </style>
</head>
<body class="flex bg-gray-100 min-h-screen font-sans text-gray-800">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 p-6 md:p-10 overflow-x-hidden">
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4 animate-card" style="animation-delay: 0s;">
            <div>
                <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 mb-2">
                    Galeri <span class="text-purple-600">Foto</span>
                </h1>
                <p class="text-gray-500 text-lg font-medium">
                    Koleksi momen terbaik yang tersimpan rapi.
                </p>
            </div>
            
            <div class="bg-white px-5 py-2.5 rounded-xl shadow-sm border border-gray-200 flex items-center gap-3">
                <div class="bg-purple-100 p-2 rounded-lg text-purple-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                    <span class="block text-xs text-gray-400 font-semibold uppercase tracking-wider">Total Album</span>
                    <span class="block text-lg font-bold text-gray-800">
                        <%= (galeriList && galeriList.length > 0) ? galeriList.length : 0 %>
                    </span>
                </div>
            </div>
        </div>

        <% if (galeriList && galeriList.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <% galeriList.forEach((galeri, index) => { %>
                    <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-gray-100 transition-all duration-300 transform hover:-translate-y-1 animate-card"
                         style="animation-delay: <%= 0.1 + (index * 0.05) %>s">
                        
                        <div class="relative h-56 overflow-hidden bg-gray-200">
                            <a href="/user/galeri/<%= galeri.ID_GroupFoto %>" class="block w-full h-full cursor-pointer">
                                <% if (galeri.dataValues.thumbnailFile) { %>
                                    <img src="/images/galeri/<%= galeri.dataValues.thumbnailFile %>" 
                                         alt="<%= galeri.Nama %>"
                                         loading="lazy"
                                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-300">
                                        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                <% } %>
                                
                                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
                            </a>

                            <div class="absolute top-3 right-3 bg-black/60 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1 shadow-sm">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <%= galeri.dataValues.fotoCount || 0 %>
                            </div>
                        </div>

                        <div class="p-5">
                            <h3 class="text-lg font-bold text-gray-800 mb-1 line-clamp-1 group-hover:text-purple-600 transition-colors">
                                <%= galeri.Nama || 'Album Tanpa Nama' %>
                            </h3>
                            <p class="text-xs text-gray-500 mb-4">
                                Dibuat: <%= new Date(galeri.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                            </p>

                            <a href="/user/galeri/<%= galeri.ID_GroupFoto %>" 
                               class="inline-flex items-center justify-center w-full px-4 py-2.5 text-sm font-semibold text-purple-600 bg-purple-50 rounded-xl hover:bg-purple-600 hover:text-white transition-all duration-300 group-hover:shadow-md">
                                Lihat Galeri
                                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="animate-card flex flex-col items-center justify-center py-20 px-4">
                <div class="relative mb-6">
                    <div class="absolute inset-0 bg-purple-200 rounded-full opacity-20 blur-xl"></div>
                    <div class="relative bg-white p-6 rounded-full shadow-lg">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-2">Belum ada Album</h3>
                <p class="text-gray-500 text-center max-w-sm">
                    Saat ini belum ada album foto yang dibuat. Album yang Anda tambahkan akan muncul di sini.
                </p>
            </div>
        <% } %>
    </main>

</body>
</html>
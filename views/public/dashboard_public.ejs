<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-R">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Publik - Bausasran</title>
    
    <link rel="stylesheet" href="/css/globals.css">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              // Palet Warna Kustom:
              'primary-base': '#003024',       // Hijau Gelap (Base)
              'primary-accent': '#83C540',     // Hijau Muda (Important/Accent)
              'text-light': '#FFFFFF',         // Putih (Body Text)
              'text-dark': '#333333',          // Teks gelap (untuk konten di atas latar putih)
            }
          }
        }
      }
    </script>
</head>

<body class="bg-primary-base font-sans">

    <%- include('../partials/navbar.ejs') %>

    <header class="bg-primary-base text-text-light text-center p-16 md:p-24">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Selamat Datang di Bausasran</h1>
        <p class="text-lg md:text-xl text-primary-accent">Menjelajahi Potensi, Mengukir Prestasi.</p>
    </header>

    <main class="container mx-auto p-6 md:p-12 bg-white shadow-xl rounded-lg">
    
        <%- include('../partials/flash.ejs') %>

        <section id="kegiatan" class="mb-12 scroll-mt-20">
            <h2 class="text-3xl font-bold text-primary-base text-center mb-8">Kegiatan Terbaru</h2>
            
            <% if(kegiatan && kegiatan.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% for(let item of kegiatan) { %>
                        <div class="bg-white rounded-lg shadow-lg overflow-hidden transition-transform transform hover:-translate-y-1">
                            <img src="https://via.placeholder.com/400x250?text=Foto+Kegiatan" alt="Foto Kegiatan" class="w-full h-48 object-cover">
                            <div class="p-5">
                                <p class="text-sm text-gray-500 mb-1">
                                    <%= new Date(item.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </p>
                                <h3 class="text-xl font-semibold text-gray-900 mb-2 truncate"><%= item.Judul %></h3>
                                <a href="/kegiatan/<%= item.ID_Kegiatan %>" class="text-primary-accent hover:text-primary-base font-medium">
                                    Lihat Detail &rarr;
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <p class="text-center text-gray-500">Belum ada data kegiatan untuk ditampilkan.</p>
            <% } %>
        </section>

        <section id="produk" class="mb-12 scroll-mt-20">
            <h2 class="text-3xl font-bold text-primary-base text-center mb-8">Produk Unggulan</h2>
            <% if(produk && produk.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% for(let item of produk) { %>
                        <div class="bg-white rounded-lg shadow-lg overflow-hidden transition-transform transform hover:-translate-y-1">
                            <img src="https://via.placeholder.com/400x250?text=Foto+Produk" alt="Foto Produk" class="w-full h-48 object-cover">
                            <div class="p-5">
                                <span class="inline-block bg-primary-accent text-primary-base text-xs font-semibold px-2 py-1 rounded-full mb-2">
                                    <%= item.Kategori || 'Umum' %>
                                </span>
                                <h3 class="text-xl font-semibold text-gray-900 mb-2 truncate"><%= item.Nama %></h3>
                                <p class="text-2xl font-bold text-primary-accent mb-3">
                                    Rp <%= new Intl.NumberFormat('id-ID').format(item.Harga) %>
                                </p>
                                <a href="/produk/<%= item.ID_Product %>" class="w-full text-center block bg-primary-accent hover:bg-primary-base text-text-light font-semibold py-2 px-4 rounded-lg">
                                    Lihat Produk
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <p class="text-center text-gray-500">Belum ada data produk untuk ditampilkan.</p>
            <% } %>
        </section>
    </main>

    <footer class="bg-primary-base text-text-light text-center p-8 mt-12">
        <p>&copy; 2024 Bausasran. All rights reserved.</p>
    </footer>

</body>
</html>
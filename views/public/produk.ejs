<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produk - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* --- 1. GLOBAL THEME --- */
        body {
            background-color: #003024 !important;
            min-height: 100vh;
            font-family: 'Segoe UI', Roboto, sans-serif;
            color: #FFFFFF;
        }

        /* Pattern Background */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(circle at 80% 80%, rgba(131, 197, 64, 0.05) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }

        main {
            position: relative;
            z-index: 1;
        }

        /* --- 2. HEADER --- */
        .page-header {
            text-align: center;
            margin-bottom: 3rem;
        }
        .page-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            color: #FFFFFF;
        }
        .page-subtitle {
            font-size: 1.1rem;
            opacity: 0.8;
            font-weight: 300;
            color: #e5e7eb;
        }
        .divider {
            height: 4px;
            width: 60px;
            background: #83C540;
            margin: 20px auto;
            border-radius: 2px;
        }

        /* --- 3. SEARCH & FILTER --- */
        .controls-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            margin-bottom: 3rem;
        }

        /* Search Bar */
        .search-wrapper {
            position: relative;
            width: 100%;
            max-width: 500px;
        }
        .search-input {
            width: 100%;
            padding: 12px 20px 12px 50px;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.1);
            color: white;
            font-size: 1rem;
            outline: none;
            backdrop-filter: blur(5px);
            transition: all 0.3s;
        }
        .search-input:focus {
            background: rgba(255,255,255,0.2);
            border-color: #83C540;
            box-shadow: 0 0 15px rgba(131, 197, 64, 0.3);
        }
        .search-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #ccc;
        }

        /* Category Buttons */
        .filter-wrapper {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
        }
        .filter-btn {
            padding: 8px 20px;
            border-radius: 30px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.2);
            color: #ccc;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.9rem;
        }
        .filter-btn:hover, .filter-btn.active {
            background: #83C540;
            color: #003024;
            border-color: #83C540;
        }

        /* --- 4. PRODUCT CARDS --- */
        .produk-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
        }

        .produk-card {
            background: #FFFFFF;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: transform 0.3s, box-shadow 0.3s;
            position: relative;
            display: flex;
            flex-direction: column;
            
            /* Animasi State */
            opacity: 1;
            transform: scale(1);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .produk-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .produk-card.anim-out {
            opacity: 0;
            transform: scale(0.9);
            pointer-events: none;
        }
        .produk-card.hidden-item {
            display: none;
        }

        /* Image Area */
        .img-wrapper {
            position: relative;
            height: 240px;
            overflow: hidden;
            background: #f3f4f6;
        }

        .img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .produk-card:hover .img-wrapper img {
            transform: scale(1.1);
        }

        .category-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(0, 48, 36, 0.85);
            color: #fff;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            backdrop-filter: blur(4px);
            z-index: 2;
        }

        /* Content Area */
        .card-body {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .produk-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 8px;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .produk-desc {
            font-size: 0.9rem;
            color: #6b7280;
            margin-bottom: 15px;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .price-tag {
            font-size: 1.3rem;
            font-weight: 800;
            color: #83C540; /* Warna Hijau Bausasran */
            margin-bottom: 20px;
            margin-top: auto;
        }

        /* Action Buttons */
        .btn-group {
            display: flex;
            gap: 10px;
        }

        .btn-action {
            flex: 1;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        .btn-detail {
            background: #f3f4f6;
            color: #374151;
        }
        .btn-detail:hover {
            background: #e5e7eb;
            color: #111;
        }

        .btn-wa {
            background: #25D366;
            color: white;
        }
        .btn-wa:hover {
            background: #1ebc57;
            box-shadow: 0 4px 10px rgba(37, 211, 102, 0.3);
        }

        /* Animation */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            opacity: 0;
            animation: fadeInUp 0.6s ease forwards;
        }
    </style>
</head>
<body>

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <div class="page-header animate-fade-in">
            <h1 class="page-title">Produk Unggulan</h1>
            <p class="page-subtitle">Temukan berbagai produk berkualitas yang dikelola oleh Bausasran.</p>
            <div class="divider"></div>
        </div>

        <% 
            let categories = [];
            if(produkList && produkList.length > 0) {
                // Mengambil kategori unik dari list produk
                categories = [...new Set(produkList.map(p => p.Kategori).filter(Boolean))];
            }
        %>

        <div class="controls-container animate-fade-in" style="animation-delay: 0.1s;">
            <div class="search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="Cari nama produk..." onkeyup="filterProduk()">
            </div>

            <% if(categories.length > 0) { %>
                <div class="filter-wrapper">
                    <button class="filter-btn active" onclick="setCategory('all', this)">Semua</button>
                    <% categories.forEach(cat => { %>
                        <button class="filter-btn" onclick="setCategory('<%= cat %>', this)"><%= cat %></button>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <% if(produkList && produkList.length > 0) { %>
            <div class="produk-grid">
                <% produkList.forEach((produk, index) => { %>
                    <div class="produk-card animate-fade-in" 
                         style="animation-delay: <%= 0.2 + (index * 0.05) %>s"
                         data-category="<%= produk.Kategori %>"
                         data-name="<%= produk.Nama.toLowerCase() %>">
                        
                        <div class="img-wrapper">
                            <img src="https://via.placeholder.com/400x300?text=<%= encodeURIComponent(produk.Nama) %>" 
                                 alt="<%= produk.Nama %>" loading="lazy">
                            
                            <% if (produk.Kategori) { %>
                                <span class="category-badge"><%= produk.Kategori %></span>
                            <% } %>
                        </div>

                        <div class="card-body">
                            <h3 class="produk-title"><%= produk.Nama %></h3>
                            
                            <% if (produk.Deskripsi) { %>
                                <p class="produk-desc"><%= produk.Deskripsi %></p>
                            <% } %>

                            <div class="price-tag">
                                Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %>
                            </div>

                            <div class="btn-group">
                                <a href="/produk/<%= produk.ID_Product %>" class="btn-action btn-detail">
                                    <i class="far fa-eye"></i> Detail
                                </a>
                                <a href="https://wa.me/62812345678?text=Halo,%20saya%20tertarik%20dengan%20produk%20<%= encodeURIComponent(produk.Nama) %>" 
                                   target="_blank" 
                                   class="btn-action btn-wa">
                                    <i class="fab fa-whatsapp"></i> Beli
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 animate-fade-in">
                <div class="inline-block p-6 rounded-full bg-white bg-opacity-10 mb-4">
                    <i class="fas fa-box-open fa-3x text-gray-400"></i>
                </div>
                <h3 class="text-xl font-semibold text-white mb-2">Belum Ada Produk</h3>
                <p class="text-gray-400">Produk akan segera ditambahkan ke katalog.</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        let currentCategory = 'all';

        function setCategory(category, btn) {
            currentCategory = category;
            
            // Update Active Class
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            if(btn) btn.classList.add('active');

            filterProduk();
        }

        function filterProduk() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.produk-card');

            cards.forEach(card => {
                const cardCat = card.getAttribute('data-category');
                const cardName = card.getAttribute('data-name');

                // Logic Filter Gabungan (Category AND Search)
                const matchCategory = (currentCategory === 'all') || (cardCat === currentCategory);
                const matchSearch = cardName.includes(searchTerm);

                if (matchCategory && matchSearch) {
                    // Show
                    if(card.classList.contains('hidden-item')) {
                        card.classList.remove('hidden-item');
                        setTimeout(() => {
                            card.classList.remove('anim-out');
                        }, 50);
                    } else {
                        card.classList.remove('anim-out');
                    }
                } else {
                    // Hide
                    card.classList.add('anim-out');
                    setTimeout(() => {
                        if(card.classList.contains('anim-out')){
                            card.classList.add('hidden-item');
                        }
                    }, 400);
                }
            });
        }
    </script>

</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kegiatan - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* --- 1. GLOBAL & THEME --- */
        body {
            background-color: #003024 !important; /* Hijau Gelap Bausasran */
            min-height: 100vh;
            font-family: 'Segoe UI', Roboto, sans-serif;
            color: #FFFFFF;
        }

        /* Pattern background halus */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(circle at 10% 20%, rgba(131, 197, 64, 0.05) 0%, transparent 40%);
            pointer-events: none;
            z-index: 0;
        }

        main {
            position: relative;
            z-index: 1;
        }

        /* --- 2. HEADER & TYPOGRAPHY --- */
        .page-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            color: #FFFFFF;
        }
        
        .page-subtitle {
            font-size: 1.1rem;
            opacity: 0.8;
            font-weight: 300;
            color: #e5e7eb;
            max-width: 600px;
            margin: 0 auto;
        }

        .divider {
            height: 4px;
            width: 60px;
            background: #83C540;
            margin: 20px auto;
            border-radius: 2px;
        }

        /* --- 3. SEARCH & CONTROLS (NEW ADDITION) --- */
        .controls-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            margin-bottom: 3rem;
        }

        /* Search Bar Style */
        .search-wrapper {
            position: relative;
            width: 100%;
            max-width: 500px;
        }
        .search-input {
            width: 100%;
            padding: 12px 20px 12px 50px;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.1);
            color: white;
            font-size: 1rem;
            outline: none;
            backdrop-filter: blur(5px);
            transition: all 0.3s;
        }
        .search-input:focus {
            background: rgba(255,255,255,0.2);
            border-color: #83C540;
            box-shadow: 0 0 15px rgba(131, 197, 64, 0.3);
        }
        .search-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #ccc;
        }

        /* Filter Tabs */
        .filter-wrapper {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .filter-group {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
            padding: 6px;
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: inline-flex;
            gap: 5px;
        }

        .filter-btn {
            padding: 10px 30px;
            border-radius: 40px;
            border: none;
            background: transparent;
            color: #ccc;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-btn:hover {
            color: #fff;
        }

        .filter-btn.active {
            background-color: #83C540;
            color: #003024;
            box-shadow: 0 4px 15px rgba(131, 197, 64, 0.3);
        }

        /* --- 4. CARD STYLE --- */
        .kegiatan-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2rem;
        }

        .kegiatan-card {
            background: #FFFFFF;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.4s ease;
            position: relative;
            display: flex;
            flex-direction: column;
            
            /* Animasi State */
            opacity: 1;
            transform: scale(1);
        }

        .kegiatan-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        /* Class untuk animasi filter */
        .kegiatan-card.anim-out {
            opacity: 0;
            transform: scale(0.95);
            pointer-events: none;
        }
        
        .kegiatan-card.hidden-item {
            display: none;
        }

        /* Image Area */
        .card-img-wrapper {
            position: relative;
            height: 200px;
            overflow: hidden;
        }

        .card-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .kegiatan-card:hover .card-img-wrapper img {
            transform: scale(1.1);
        }

        .status-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            z-index: 2;
        }

        .badge-upcoming {
            background-color: #83C540;
            color: #003024;
        }

        .badge-past {
            background-color: #6b7280;
            color: #ffffff;
        }

        /* Content Area */
        .card-content {
            padding: 24px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            color: #1f2937; /* Text gelap di card putih */
        }

        .meta-date {
            display: flex;
            align-items: center;
            font-size: 0.85rem;
            color: #6b7280;
            margin-bottom: 12px;
            font-weight: 500;
        }
        
        .meta-date i {
            color: #83C540;
            margin-right: 8px;
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 10px;
            line-height: 1.4;
            color: #111;
            /* Limit 2 baris */
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .card-desc {
            font-size: 0.95rem;
            color: #4b5563;
            line-height: 1.6;
            margin-bottom: 16px;
            /* Limit 3 baris */
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .meta-location {
            display: flex;
            align-items: flex-start;
            font-size: 0.9rem;
            color: #6b7280;
            margin-bottom: 20px;
            margin-top: auto; /* Push ke bawah jika konten sedikit */
        }

        .meta-location i {
            color: #83C540;
            margin-right: 8px;
            margin-top: 3px;
        }

        .btn-detail {
            display: block;
            width: 100%;
            text-align: center;
            background-color: #003024;
            color: #fff;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-detail:hover {
            background-color: #83C540;
            color: #003024;
        }

        /* Animation Keyframes */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            opacity: 0;
            animation: fadeInUp 0.6s ease forwards;
        }

        /* Responsive Text */
        @media (max-width: 768px) {
            .page-title { font-size: 2rem; }
            .kegiatan-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <div class="text-center mb-8 animate-fade-in" style="animation-delay: 0.1s;">
            <h1 class="page-title">Kegiatan Kami</h1>
            <p class="page-subtitle">Berbagai agenda, acara, dan momentum berharga yang dilaksanakan oleh Bausasran.</p>
            <div class="divider"></div>
        </div>

        <div class="controls-container animate-fade-in" style="animation-delay: 0.2s;">
            <div class="search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="Cari nama kegiatan..." onkeyup="masterFilter()">
            </div>

            <div class="filter-wrapper">
                <div class="filter-group">
                    <button onclick="setStatus('all', this)" id="btnAll" class="filter-btn active">
                        Semua
                    </button>
                    <button onclick="setStatus('upcoming', this)" id="btnUpcoming" class="filter-btn">
                        Upcoming
                    </button>
                    <button onclick="setStatus('past', this)" id="btnPast" class="filter-btn">
                        Selesai
                    </button>
                </div>
            </div>
        </div>

        <% if(kegiatanList && kegiatanList.length > 0) { %>
            <div class="kegiatan-grid" id="kegiatanGrid">
                <% kegiatanList.forEach((kegiatan, index) => { %>
                    <div class="kegiatan-card animate-fade-in" 
                         style="animation-delay: <%= 0.3 + (index * 0.1) %>s"
                         data-status="<%= kegiatan.Status %>"
                         data-title="<%= kegiatan.Judul.toLowerCase() %>">
                        
                        <div class="card-img-wrapper">
                            <img src="https://via.placeholder.com/400x250?text=<%= encodeURIComponent(kegiatan.Judul) %>" 
                                 alt="<%= kegiatan.Judul %>" loading="lazy">
                            
                            <span class="status-badge <%= kegiatan.Status === 'Upcoming' ? 'badge-upcoming' : 'badge-past' %>">
                                <%= kegiatan.Status %>
                            </span>
                        </div>

                        <div class="card-content">
                            <div class="meta-date">
                                <i class="far fa-calendar-alt"></i>
                                <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                            </div>

                            <h3 class="card-title"><%= kegiatan.Judul %></h3>

                            <% if (kegiatan.Deskripsi) { %>
                                <p class="card-desc"><%= kegiatan.Deskripsi %></p>
                            <% } %>

                            <% if (kegiatan.Lokasi) { %>
                                <div class="meta-location">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <span><%= kegiatan.Lokasi %></span>
                                </div>
                            <% } %>

                            <a href="/kegiatan/<%= kegiatan.ID_Kegiatan %>" class="btn-detail">
                                Lihat Detail <i class="fas fa-arrow-right" style="margin-left: 5px; font-size: 0.8rem;"></i>
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 text-gray-400 animate-fade-in">
                <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;">
                    <i class="far fa-calendar-times"></i>
                </div>
                <h3 class="text-2xl font-semibold mb-2" style="color:white">Belum Ada Kegiatan</h3>
                <p>Kegiatan akan segera hadir. Pantau terus halaman ini!</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // State Global
        let currentStatus = 'all';

        function setStatus(status, btnElement) {
            currentStatus = status;

            // 1. Update Button Visual (Active State)
            const buttons = document.querySelectorAll('.filter-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            if(btnElement) btnElement.classList.add('active');

            // 2. Trigger Logic Filter Utama
            masterFilter();
        }

        function masterFilter() {
            // Ambil value dari search input
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            
            // Ambil semua kartu
            const cards = document.querySelectorAll('.kegiatan-card');

            cards.forEach(card => {
                // Ambil data atribut
                const cardStatus = card.getAttribute('data-status').toLowerCase();
                const cardTitle = card.getAttribute('data-title');

                // Logic Filter Gabungan (AND)
                // 1. Cek Status (Apakah 'all' ATAU status card sesuai dengan status yang dipilih)
                const isStatusMatch = (currentStatus === 'all') || (cardStatus === currentStatus.toLowerCase());
                
                // 2. Cek Search (Apakah judul mengandung kata kunci pencarian)
                const isSearchMatch = cardTitle.includes(searchTerm);

                // Jika KEDUANYA benar, tampilkan card
                if (isStatusMatch && isSearchMatch) {
                    // Show Logic
                    if(card.classList.contains('hidden-item')) {
                        card.classList.remove('hidden-item');
                        // Delay sedikit untuk animasi remove
                        setTimeout(() => {
                            card.classList.remove('anim-out');
                        }, 50);
                    } else {
                        card.classList.remove('anim-out');
                    }
                } else {
                    // Hide Logic
                    card.classList.add('anim-out');
                    
                    // Tunggu animasi CSS selesai baru display:none
                    setTimeout(() => {
                        if(card.classList.contains('anim-out')){
                            card.classList.add('hidden-item');
                        }
                    }, 400); 
                }
            });
        }
    </script>

</body>
</html>
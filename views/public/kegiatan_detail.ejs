<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= kegiatan.Judul %> - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* --- 1. GLOBAL THEME --- */
        body {
            background-color: #003024 !important;
            min-height: 100vh;
            font-family: 'Segoe UI', Roboto, sans-serif;
            color: #333; /* Default text color inside white card */
        }

        /* Background Pattern */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(circle at 80% 20%, rgba(131, 197, 64, 0.08) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        main {
            position: relative;
            z-index: 1;
        }

        /* --- 2. BREADCRUMB --- */
        .breadcrumb-item a {
            color: #ccc;
            transition: color 0.2s;
            text-decoration: none;
        }
        .breadcrumb-item a:hover {
            color: #83C540;
        }
        .breadcrumb-separator {
            color: #666;
            margin: 0 8px;
        }
        .breadcrumb-current {
            color: #83C540;
            font-weight: 600;
        }

        /* --- 3. MAIN CARD --- */
        .detail-card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Hero Image Area */
        .hero-section {
            position: relative;
            height: 450px;
            overflow: hidden;
        }

        .hero-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s ease;
        }
        
        /* Fallback gradient jika tidak ada foto */
        .hero-fallback {
            height: 400px;
            background: linear-gradient(135deg, #003024 0%, #004d3a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.2);
        }

        /* --- 4. CONTENT STYLING --- */
        .content-wrapper {
            padding: 40px;
        }

        @media (max-width: 768px) {
            .hero-section { height: 250px; }
            .content-wrapper { padding: 24px; }
        }

        .badge-status {
            padding: 6px 16px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-upcoming { background: #ecfccb; color: #365314; border: 1px solid #83C540; }
        .badge-past { background: #f3f4f6; color: #4b5563; border: 1px solid #d1d5db; }

        .kegiatan-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: #111;
            margin: 15px 0;
            line-height: 1.2;
        }

        .meta-info {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid #eee;
        }

        .meta-item {
            display: flex;
            align-items: center;
            color: #555;
            font-weight: 500;
        }
        .meta-item i {
            color: #83C540;
            margin-right: 8px;
            font-size: 1.1rem;
        }

        .description-text {
            font-size: 1.05rem;
            line-height: 1.8;
            color: #374151;
            white-space: pre-line; /* Agar enter di database terbaca */
        }

        /* --- 5. GALLERY GRID --- */
        .mini-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .gallery-item {
            border-radius: 12px;
            overflow: hidden;
            height: 120px;
            cursor: pointer;
            position: relative;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        /* --- 6. TESTIMONIALS --- */
        .review-card {
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 20px;
            background: #fafafa;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .review-card:hover {
            background: #fff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border-color: #83C540;
        }

        .avatar-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, #83C540, #003024);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.2rem;
        }

        /* --- 7. BUTTONS --- */
        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            gap: 8px;
        }

        .btn-back {
            background: #f3f4f6;
            color: #4b5563;
        }
        .btn-back:hover { background: #e5e7eb; color: #111; }

        .btn-primary {
            background: #003024;
            color: #fff;
        }
        .btn-primary:hover {
            background: #83C540;
            color: #003024;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(131, 197, 64, 0.4);
        }

        /* --- 8. LIGHTBOX SIMPLE --- */
        #detail-lightbox {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 48, 36, 0.95);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }
        #detail-lightbox img {
            max-width: 90%;
            max-height: 90vh;
            border-radius: 8px;
            box-shadow: 0 0 50px rgba(0,0,0,0.5);
        }
        .close-lightbox {
            position: absolute;
            top: 20px;
            right: 30px;
            font-size: 40px;
            color: white;
            cursor: pointer;
        }

        /* Animations */
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(50px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <nav class="mb-8 text-sm">
            <div class="flex items-center">
                <div class="breadcrumb-item"><a href="/">Home</a></div>
                <div class="breadcrumb-separator">/</div>
                <div class="breadcrumb-item"><a href="/kegiatan">Kegiatan</a></div>
                <div class="breadcrumb-separator">/</div>
                <div class="breadcrumb-item breadcrumb-current truncate max-w-xs"><%= kegiatan.Judul %></div>
            </div>
        </nav>

        <article class="detail-card">
            
            <% if (fotoFiles && fotoFiles.length > 0) { %>
                <div class="hero-section">
                    <img 
                        src="/images/kegiatan/<%= fotoFiles[0] %>" 
                        alt="<%= kegiatan.Judul %>" 
                        class="hero-img"
                        onclick="openDetailLightbox(this.src)"
                        style="cursor: zoom-in;"
                        onerror="this.src='https://via.placeholder.com/1200x400?text=Foto+Kegiatan'">
                    
                    <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 100px; background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);"></div>
                </div>
            <% } else { %>
                <div class="hero-fallback">
                    <div class="text-center">
                        <i class="far fa-image fa-3x mb-3"></i>
                        <p class="font-semibold">Belum ada foto</p>
                    </div>
                </div>
            <% } %>

            <div class="content-wrapper">
                
                <div class="mb-6">
                    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                        <div>
                            <span class="badge-status <%= kegiatan.Status === 'Upcoming' ? 'badge-upcoming' : 'badge-past' %>">
                                <%= kegiatan.Status %>
                            </span>
                            <% if (kegiatan.Kategori) { %>
                                <span class="text-gray-400 text-sm font-semibold ml-3 tracking-wide uppercase"><%= kegiatan.Kategori %></span>
                            <% } %>
                        </div>
                        
                        <% if(reviewList && reviewList.length > 0) { %>
                            <div class="flex items-center bg-yellow-50 px-3 py-1 rounded-lg border border-yellow-200">
                                <i class="fas fa-star text-yellow-500 mr-2"></i>
                                <span class="font-bold text-gray-800"><%= avgRating %></span>
                                <span class="text-gray-500 text-xs ml-1">/ 5 (<%= totalReview %>)</span>
                            </div>
                        <% } %>
                    </div>

                    <h1 class="kegiatan-title"><%= kegiatan.Judul %></h1>

                    <div class="meta-info">
                        <div class="meta-item">
                            <i class="far fa-calendar-alt"></i>
                            <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                        </div>
                        <% if (kegiatan.Lokasi) { %>
                            <div class="meta-item">
                                <i class="fas fa-map-marker-alt"></i>
                                <%= kegiatan.Lokasi %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                    
                    <div class="lg:col-span-2">
                        <div class="mb-10">
                            <h2 class="text-2xl font-bold text-gray-800 mb-4 border-l-4 border-[#83C540] pl-4">Deskripsi</h2>
                            <div class="description-text">
                                <% if (kegiatan.Deskripsi) { %>
                                    <%= kegiatan.Deskripsi %>
                                <% } else { %>
                                    <em class="text-gray-400">Tidak ada deskripsi detail tersedia untuk kegiatan ini.</em>
                                <% } %>
                            </div>
                        </div>

                        <% if (fotoFiles && fotoFiles.length > 1) { %>
                            <div class="mb-10">
                                <h2 class="text-xl font-bold text-gray-800 mb-4">Dokumentasi Lainnya</h2>
                                <div class="mini-gallery">
                                    <% fotoFiles.forEach((foto, index) => { %>
                                        <% if (index > 0) { %> 
                                            <div class="gallery-item" onclick="openDetailLightbox('/images/kegiatan/<%= foto %>')">
                                                <img src="/images/kegiatan/<%= foto %>" alt="Dokumentasi" loading="lazy">
                                            </div>
                                        <% } %>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <div class="lg:col-span-1">
                        <div class="bg-gray-50 p-6 rounded-xl border border-gray-100 sticky top-6">
                            
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-xl font-bold text-gray-800">Ulasan</h3>
                                <% if (currentUser && currentUser.Role === 'User') { %>
                                    <a href="/user/testimoni/tambah" class="text-sm font-semibold text-[#83C540] hover:underline">
                                        + Tulis
                                    </a>
                                <% } %>
                            </div>

                            <div class="space-y-4 mb-6 max-h-[500px] overflow-y-auto pr-2 custom-scrollbar">
                                <% if (reviewList && reviewList.length > 0) { %>
                                    <% reviewList.forEach(review => { %>
                                        <div class="review-card">
                                            <div class="flex items-center gap-3 mb-2">
                                                <div class="avatar-circle">
                                                    <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0).toUpperCase() : '?' %>
                                                </div>
                                                <div>
                                                    <p class="font-bold text-sm text-gray-800">
                                                        <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'User' %>
                                                    </p>
                                                    <div class="text-yellow-500 text-xs">
                                                        <%= '⭐'.repeat(review.Rating) %>
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="text-gray-600 text-sm italic">"<%= review.Ulasan || '-' %>"</p>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="text-center py-6 text-gray-400">
                                        <i class="far fa-comment-dots fa-2x mb-2"></i>
                                        <p class="text-sm">Belum ada ulasan.</p>
                                    </div>
                                <% } %>
                            </div>

                            <div class="flex flex-col gap-3">
                                <% if (!currentUser) { %>
                                    <a href="/login?returnTo=/kegiatan/<%= kegiatan.ID_Kegiatan %>" class="btn-action btn-primary w-full text-center">
                                        <i class="fas fa-lock"></i> Login untuk Review
                                    </a>
                                <% } %>
                                <a href="/kegiatan" class="btn-action btn-back w-full text-center">
                                    <i class="fas fa-arrow-left"></i> Kembali
                                </a>
                            </div>

                        </div>
                    </div>

                </div> </div>
        </article>
    </main>

    <%- include('../partials/footer.ejs') %>

    <div id="detail-lightbox" onclick="closeDetailLightbox()">
        <span class="close-lightbox">&times;</span>
        <img id="lightbox-image-target" src="" alt="Full Preview">
    </div>

    <script>
        // Lightbox Logic
        function openDetailLightbox(src) {
            const lb = document.getElementById('detail-lightbox');
            const img = document.getElementById('lightbox-image-target');
            img.src = src;
            lb.style.display = 'flex';
            document.body.style.overflow = 'hidden'; // Prevent scrolling
        }

        function closeDetailLightbox() {
            const lb = document.getElementById('detail-lightbox');
            lb.style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        // Close on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === "Escape") closeDetailLightbox();
        });
    </script>

</body>
</html>
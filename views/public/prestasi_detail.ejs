<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= prestasi.Judul %> - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* --- 1. GLOBAL THEME --- */
        body {
            background-color: #003024 !important;
            min-height: 100vh;
            font-family: 'Segoe UI', Roboto, sans-serif;
            color: #FFFFFF;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(circle at 50% 10%, rgba(250, 204, 21, 0.08) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }

        main {
            position: relative;
            z-index: 1;
        }

        /* --- 2. BREADCRUMB --- */
        .breadcrumb-nav { margin-bottom: 2rem; font-size: 0.95rem; }
        .breadcrumb-item a { color: #ccc; text-decoration: none; transition: color 0.2s; }
        .breadcrumb-item a:hover { color: #FACC15; }
        .breadcrumb-separator { color: #666; margin: 0 8px; }
        .breadcrumb-current { color: #FACC15; font-weight: 600; }

        /* --- 3. AWARD CARD --- */
        .award-card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }

        /* Decorative Gold Top Border */
        .award-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 6px;
            background: linear-gradient(90deg, #FACC15, #b45309, #FACC15);
        }

        .award-header {
            text-align: center;
            padding: 50px 30px 30px 30px;
            background: linear-gradient(to bottom, #fff, #fefce8);
            border-bottom: 1px solid #f3f4f6;
        }

        .trophy-icon-wrapper {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 80px; height: 80px;
            background: #FEF9C3;
            color: #854D0E;
            border-radius: 50%;
            margin-bottom: 20px;
            box-shadow: 0 0 0 8px rgba(254, 249, 195, 0.5);
            animation: bounceIn 0.8s ease;
        }

        .award-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: #111;
            margin-bottom: 10px;
            line-height: 1.2;
        }

        .award-date {
            color: #6b7280;
            font-weight: 600;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        /* Content Layout */
        .award-body {
            padding: 40px;
            display: flex;
            flex-direction: column;
            gap: 40px;
        }
        @media (min-width: 1024px) {
            .award-body { flex-direction: row; }
        }

        .content-main { flex: 2; color: #374151; }
        .content-sidebar { flex: 1; }

        /* Description */
        .desc-text {
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: 30px;
            white-space: pre-line;
        }

        /* Gallery Grid */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .gallery-item {
            position: relative;
            height: 120px;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        .gallery-item img {
            width: 100%; height: 100%; object-fit: cover;
            transition: transform 0.4s ease;
        }
        .gallery-item:hover img { transform: scale(1.1); }
        .gallery-overlay {
            position: absolute; inset: 0;
            background: rgba(0,0,0,0.3);
            display: flex; align-items: center; justify-content: center;
            opacity: 0; transition: opacity 0.3s;
        }
        .gallery-item:hover .gallery-overlay { opacity: 1; }

        /* Info Box (Sidebar) */
        .info-box {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 25px;
        }

        .info-row {
            margin-bottom: 20px;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 15px;
        }
        .info-row:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
        
        .info-label {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #9ca3af;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .info-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #111;
            display: flex; align-items: center; gap: 8px;
        }
        .info-value i { color: #d97706; }

        /* Button */
        .btn-back {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 24px;
            background: #fff;
            border: 1px solid #d1d5db;
            color: #374151;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            width: 100%;
            text-align: center;
        }
        .btn-back:hover { background: #f3f4f6; color: #000; }

        /* Lightbox */
        #lightbox {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0, 48, 36, 0.98);
            z-index: 9999;
            justify-content: center; align-items: center;
        }
        #lightbox img {
            max-width: 90%; max-height: 90vh;
            border-radius: 8px; box-shadow: 0 0 50px rgba(0,0,0,0.5);
        }
        .close-lb {
            position: absolute; top: 20px; right: 30px;
            color: white; font-size: 40px; cursor: pointer;
        }

        @keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes bounceIn { 0% { transform: scale(0); } 60% { transform: scale(1.1); } 100% { transform: scale(1); } }
    </style>
</head>
<body>

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <nav class="breadcrumb-nav">
            <span class="breadcrumb-item"><a href="/">Home</a></span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-item"><a href="/prestasi">Prestasi</a></span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-item breadcrumb-current"><%= prestasi.Judul %></span>
        </nav>

        <div class="award-card">
            
            <div class="award-header">
                <div class="trophy-icon-wrapper">
                    <i class="fas fa-trophy fa-2x"></i>
                </div>
                <h1 class="award-title"><%= prestasi.Judul %></h1>
                <div class="award-date">
                    <i class="far fa-calendar-alt"></i>
                    <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </div>
            </div>

            <div class="award-body">
                
                <div class="content-main">
                    <% if (prestasi.Kategori) { %>
                        <span class="inline-block px-3 py-1 mb-4 bg-yellow-100 text-yellow-800 text-sm font-bold rounded-full">
                            <%= prestasi.Kategori %>
                        </span>
                    <% } %>

                    <div class="desc-text text-gray-700">
                        <% if (prestasi.Deskripsi) { %>
                            <%= prestasi.Deskripsi %>
                        <% } else { %>
                            <em class="text-gray-400">Tidak ada deskripsi detail untuk prestasi ini.</em>
                        <% } %>
                    </div>

                    <% if (fotoFiles && fotoFiles.length > 0) { %>
                        <div class="mt-8 border-t border-gray-100 pt-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                                <i class="far fa-images text-yellow-600"></i> Galeri Dokumentasi
                            </h3>
                            <div class="gallery-grid">
                                <% fotoFiles.forEach((foto, index) => { %>
                                    <div class="gallery-item" onclick="openLightbox('/images/galeri/<%= foto %>')">
                                        <img src="/images/galeri/<%= foto %>" alt="Dokumentasi Prestasi">
                                        <div class="gallery-overlay">
                                            <i class="fas fa-search-plus text-white text-xl"></i>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div class="content-sidebar">
                    <div class="info-box">
                        <div class="info-row">
                            <div class="info-label">Kategori Penghargaan</div>
                            <div class="info-value">
                                <i class="fas fa-medal"></i> <%= prestasi.Kategori || '-' %>
                            </div>
                        </div>

                        <div class="info-row">
                            <div class="info-label">Tanggal Pencapaian</div>
                            <div class="info-value">
                                <i class="far fa-clock"></i> 
                                <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { month: 'short', year: 'numeric' }) %>
                            </div>
                        </div>

                        <% if (groupFoto) { %>
                            <div class="info-row">
                                <div class="info-label">Album Terkait</div>
                                <div class="info-value">
                                    <i class="far fa-folder-open"></i> <%= groupFoto.Nama %>
                                </div>
                            </div>
                        <% } %>

                        <a href="/prestasi" class="btn-back">
                            <i class="fas fa-arrow-left mr-2"></i> Kembali
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <div id="lightbox" onclick="closeLightbox()">
        <span class="close-lb">&times;</span>
        <img id="lb-img" src="" alt="Zoom Image">
    </div>

    <script>
        function openLightbox(src) {
            document.getElementById('lb-img').src = src;
            document.getElementById('lightbox').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            document.getElementById('lightbox').style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        document.addEventListener('keydown', function(e) {
            if(e.key === "Escape") closeLightbox();
        });
    </script>

</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= produk.Nama %> - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* --- 1. GLOBAL THEME --- */
        body {
            background-color: #003024 !important;
            min-height: 100vh;
            font-family: 'Segoe UI', Roboto, sans-serif;
            color: #FFFFFF;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(circle at 10% 20%, rgba(131, 197, 64, 0.05) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        main {
            position: relative;
            z-index: 1;
        }

        /* --- 2. BREADCRUMB --- */
        .breadcrumb-nav {
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }
        .breadcrumb-item a {
            color: #ccc;
            text-decoration: none;
            transition: color 0.2s;
        }
        .breadcrumb-item a:hover { color: #83C540; }
        .breadcrumb-separator { color: #666; margin: 0 8px; }
        .breadcrumb-current { color: #83C540; font-weight: 600; }

        /* --- 3. PRODUCT CARD (Upper Section) --- */
        .product-main-card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            margin-bottom: 30px;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .product-layout {
            display: flex;
            flex-direction: column;
        }
        @media (min-width: 1024px) {
            .product-layout { flex-direction: row; }
        }

        /* Left Column: Gallery */
        .gallery-section {
            flex: 1;
            padding: 20px;
            background: #f9fafb;
        }

        .main-image-wrapper {
            position: relative;
            width: 100%;
            height: 400px;
            border-radius: 12px;
            overflow: hidden;
            background: white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            margin-bottom: 15px;
            cursor: zoom-in;
        }
        
        .main-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Agar produk terlihat utuh */
            transition: opacity 0.3s ease;
        }

        .thumbnail-list {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 5px;
        }
        
        .thumb-item {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            opacity: 0.7;
            transition: all 0.2s;
        }
        .thumb-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .thumb-item:hover { opacity: 1; }
        .thumb-item.active {
            border-color: #83C540;
            opacity: 1;
            transform: translateY(-2px);
        }

        /* Right Column: Info & CTA */
        .info-section {
            flex: 1;
            padding: 40px;
            color: #333;
            display: flex;
            flex-direction: column;
        }

        .product-category {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #83C540;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .product-title {
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 10px;
            color: #111;
        }

        .rating-wrapper {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            font-size: 0.95rem;
        }
        .stars { color: #facc15; margin-right: 8px; }
        .review-count { color: #6b7280; text-decoration: underline; cursor: pointer; }

        .price-wrapper {
            margin-bottom: 25px;
            padding-bottom: 25px;
            border-bottom: 1px solid #e5e7eb;
        }
        .price-text {
            font-size: 2rem;
            font-weight: 800;
            color: #003024;
        }

        .short-desc {
            color: #4b5563;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        /* Buttons */
        .cta-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: auto;
        }
        
        .btn-wa {
            background: #25D366;
            color: white;
            padding: 16px;
            border-radius: 12px;
            font-weight: 700;
            text-align: center;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 1.1rem;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
        }
        .btn-wa:hover {
            background: #1ebc57;
            transform: translateY(-2px);
        }

        .btn-secondary-group {
            display: flex;
            gap: 10px;
        }
        .btn-sec {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .btn-blue { background: #eff6ff; color: #2563eb; }
        .btn-blue:hover { background: #dbeafe; }
        .btn-gray { background: #f3f4f6; color: #4b5563; }
        .btn-gray:hover { background: #e5e7eb; color: #111; }

        /* --- 4. TABS SECTION --- */
        .tabs-card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            padding: 30px;
            color: #333;
        }

        .tabs-header {
            display: flex;
            border-bottom: 2px solid #f3f4f6;
            margin-bottom: 30px;
        }

        .tab-btn {
            padding: 15px 30px;
            font-weight: 600;
            color: #6b7280;
            background: none;
            border: none;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 1rem;
        }
        .tab-btn:hover { color: #83C540; }
        .tab-btn.active {
            color: #83C540;
            border-bottom-color: #83C540;
        }

        .tab-content { display: none; animation: fadeIn 0.4s ease; }
        .tab-content.active { display: block; }

        /* Review Items */
        .review-item {
            border-bottom: 1px solid #f3f4f6;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }
        .review-item:last-child { border-bottom: none; }
        .reviewer-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
        .reviewer-avatar {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: #003024;
            color: white;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold;
        }

        /* --- 5. LIGHTBOX --- */
        #lightbox {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 48, 36, 0.95);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        #lightbox img {
            max-width: 90%;
            max-height: 90vh;
            border-radius: 8px;
            box-shadow: 0 0 50px rgba(0,0,0,0.5);
        }
        .close-lb {
            position: absolute; top: 20px; right: 30px;
            color: white; font-size: 40px; cursor: pointer;
        }

        @keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <nav class="breadcrumb-nav">
            <span class="breadcrumb-item"><a href="/">Home</a></span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-item"><a href="/produk">Produk</a></span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-item breadcrumb-current"><%= produk.Nama %></span>
        </nav>

        <div class="product-main-card">
            <div class="product-layout">
                
                <div class="gallery-section">
                    <% if (fotoFiles && fotoFiles.length > 0) { %>
                        <div class="main-image-wrapper" onclick="openLightbox()">
                            <img id="mainImage" 
                                 src="/images/produk/<%= fotoFiles[0] %>" 
                                 alt="<%= produk.Nama %>">
                        </div>
                        
                        <% if (fotoFiles.length > 1) { %>
                            <div class="thumbnail-list">
                                <% fotoFiles.forEach((foto, index) => { %>
                                    <div class="thumb-item <%= index === 0 ? 'active' : '' %>" 
                                         onclick="changeImage('/images/produk/<%= foto %>', this)">
                                        <img src="/images/produk/<%= foto %>" alt="thumb">
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="main-image-wrapper flex items-center justify-center bg-gray-100">
                            <div class="text-center text-gray-400">
                                <i class="fas fa-image fa-3x mb-2"></i>
                                <p>Foto tidak tersedia</p>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div class="info-section">
                    <div>
                        <% if (produk.Kategori) { %>
                            <div class="product-category"><%= produk.Kategori %></div>
                        <% } %>
                        
                        <h1 class="product-title"><%= produk.Nama %></h1>
                        
                        <div class="rating-wrapper">
                            <div class="stars">
                                <% for(let i=1; i<=5; i++) { %>
                                    <% if(i <= Math.round(avgRating)) { %>
                                        <i class="fas fa-star"></i>
                                    <% } else { %>
                                        <i class="far fa-star text-gray-300"></i>
                                    <% } %>
                                <% } %>
                            </div>
                            <span class="review-count" onclick="scrollToReview()">
                                (<%= totalReview %> Ulasan)
                            </span>
                        </div>

                        <div class="price-wrapper">
                            <div class="price-text">
                                Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %>
                            </div>
                        </div>

                        <div class="short-desc">
                            <%= produk.Deskripsi ? (produk.Deskripsi.substring(0, 150) + (produk.Deskripsi.length > 150 ? '...' : '')) : 'Deskripsi lengkap tersedia di bawah.' %>
                        </div>
                    </div>

                    <div class="cta-group">
                        <a href="https://wa.me/62812345678?text=Halo,%20saya%20tertarik%20membeli%20produk%20<%= encodeURIComponent(produk.Nama) %>" 
                           target="_blank" class="btn-wa">
                            <i class="fab fa-whatsapp fa-lg"></i> Beli via WhatsApp
                        </a>
                        
                        <div class="btn-secondary-group">
                            <% if (currentUser && currentUser.Role === 'User') { %>
                                <a href="/user/testimoni/tambah" class="btn-sec btn-blue">
                                    <i class="fas fa-pen"></i> Review
                                </a>
                            <% } else if (!currentUser) { %>
                                <a href="/login?returnTo=/produk/<%= produk.ID_Product %>" class="btn-sec btn-blue">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                            <% } %>
                            
                            <a href="/produk" class="btn-sec btn-gray">
                                <i class="fas fa-arrow-left"></i> Kembali
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="tabs-card" id="detailSection">
            <div class="tabs-header">
                <button class="tab-btn active" onclick="switchTab('deskripsi', this)">Deskripsi Lengkap</button>
                <button class="tab-btn" onclick="switchTab('ulasan', this)">Ulasan Pembeli</button>
            </div>

            <div id="tab-deskripsi" class="tab-content active">
                <div class="prose max-w-none text-gray-700 leading-relaxed whitespace-pre-line">
                    <%= produk.Deskripsi || 'Belum ada deskripsi lengkap.' %>
                </div>
                
                <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 bg-gray-50 p-6 rounded-lg">
                    <div>
                        <span class="block text-sm text-gray-500">Nama Produk</span>
                        <span class="font-bold text-gray-800"><%= produk.Nama %></span>
                    </div>
                    <div>
                        <span class="block text-sm text-gray-500">Kategori</span>
                        <span class="font-bold text-gray-800"><%= produk.Kategori || '-' %></span>
                    </div>
                    <div>
                        <span class="block text-sm text-gray-500">Harga</span>
                        <span class="font-bold text-green-600">Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %></span>
                    </div>
                </div>
            </div>

            <div id="tab-ulasan" class="tab-content">
                <% if (reviewList && reviewList.length > 0) { %>
                    <% reviewList.forEach(review => { %>
                        <div class="review-item">
                            <div class="reviewer-meta">
                                <div class="reviewer-avatar">
                                    <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0).toUpperCase() : '?' %>
                                </div>
                                <div>
                                    <p class="font-bold text-gray-800 text-sm">
                                        <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'Anonymous' %>
                                    </p>
                                    <div class="text-yellow-500 text-xs">
                                        <%= '⭐'.repeat(review.Rating) %>
                                    </div>
                                </div>
                            </div>
                            <p class="text-gray-600 italic text-sm">"<%= review.Ulasan || '-' %>"</p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-10 text-gray-400">
                        <i class="far fa-comment-dots fa-2x mb-2"></i>
                        <p>Belum ada ulasan untuk produk ini.</p>
                        <% if (!currentUser) { %>
                            <a href="/login" class="text-blue-500 hover:underline text-sm">Login untuk memberi ulasan</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <div id="lightbox" onclick="closeLightbox()">
        <span class="close-lb">&times;</span>
        <img id="lb-img" src="" alt="Full View">
    </div>

    <script>
        // Gallery Logic
        function changeImage(src, thumb) {
            const mainImg = document.getElementById('mainImage');
            
            // Fade effect
            mainImg.style.opacity = '0.5';
            setTimeout(() => {
                mainImg.src = src;
                mainImg.style.opacity = '1';
            }, 200);

            // Active State
            document.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('active'));
            thumb.classList.add('active');
        }

        // Lightbox Logic
        function openLightbox() {
            const mainSrc = document.getElementById('mainImage').src;
            document.getElementById('lb-img').src = mainSrc;
            document.getElementById('lightbox').style.display = 'flex';
        }

        function closeLightbox() {
            document.getElementById('lightbox').style.display = 'none';
        }

        // Tab Logic
        function switchTab(tabName, btn) {
            // Hide all
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

            // Show selected
            document.getElementById('tab-' + tabName).classList.add('active');
            btn.classList.add('active');
        }

        function scrollToReview() {
            document.getElementById('detailSection').scrollIntoView({ behavior: 'smooth' });
            // Click the review tab programmatically
            const reviewBtn = document.querySelectorAll('.tab-btn')[1];
            if(reviewBtn) reviewBtn.click();
        }

        // Keyboard navigation for lightbox
        document.addEventListener('keydown', function(e) {
            if(e.key === "Escape") closeLightbox();
        });
    </script>

</body>
</html>
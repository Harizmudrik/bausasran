<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galeri - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* --- 1. GLOBAL & TYPOGRAPHY --- */
        body {
            background-color: #003024 !important;
            min-height: 100vh;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            overflow-x: hidden;
        }

        main {
            color: #FFFFFF;
            position: relative;
            z-index: 1;
        }

        main h1, main h2, main h3, main h4, main p {
            color: #FFFFFF !important;
        }

        /* Background Pattern Halus */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(circle at 50% 50%, rgba(131, 197, 64, 0.05) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }

        /* --- 2. FILTER BUTTONS (NEON & GLOW) --- */
        .filter-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            margin-bottom: 3rem;
            opacity: 0;
            animation: slideDown 0.8s ease forwards;
        }

        .filter-btn {
            padding: 10px 28px;
            border-radius: 50px;
            background-color: rgba(255, 255, 255, 0.05);
            color: #ccc;
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(5px);
        }

        .filter-btn:hover {
            background-color: rgba(131, 197, 64, 0.1);
            border-color: #83C540;
            color: #83C540;
            transform: translateY(-2px);
        }

        .filter-btn.active {
            background-color: #83C540 !important;
            color: #003024 !important;
            border-color: #83C540 !important;
            box-shadow: 0 0 20px rgba(131, 197, 64, 0.4);
            transform: scale(1.05);
        }

        /* --- 3. CARD STYLE & ANIMATION --- */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
        }

        .galeri-card {
            background-color: #FFFFFF;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            cursor: pointer;
            position: relative;
            transform-origin: center;
            /* Default state for animation */
            opacity: 1;
            transform: scale(1);
            transition: opacity 0.4s ease, transform 0.4s ease, box-shadow 0.3s ease;
        }

        /* Class untuk efek filter JS */
        .galeri-card.hidden-item {
            display: none; /* Tetap pakai display none agar layout flow benar */
        }
        
        .galeri-card.anim-out {
            opacity: 0;
            transform: scale(0.9);
            pointer-events: none;
        }

        .galeri-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .img-wrapper {
            height: 240px;
            width: 100%;
            background-color: #e5e7eb;
            position: relative;
            overflow: hidden;
        }

        .img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .galeri-card:hover .img-wrapper img {
            transform: scale(1.1);
        }

        /* Badge Kategori */
        .badge-category {
            position: absolute;
            top: 12px;
            left: 12px;
            background: rgba(131, 197, 64, 0.9);
            backdrop-filter: blur(4px);
            color: #003024;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 800;
            z-index: 5;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .card-body {
            padding: 20px;
            position: relative;
            background: white;
        }

        .card-desc {
            color: #1f2937 !important;
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.5;
            margin-bottom: 10px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .card-date {
            color: #6b7280 !important;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .card-date i {
            font-size: 0.8rem;
        }

        /* --- 4. MODERN LIGHTBOX --- */
        #lightbox {
            display: none;
            position: fixed;
            inset: 0;
            background-color: rgba(0, 48, 36, 0.95); /* Hijau sangat gelap transparan */
            backdrop-filter: blur(10px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        #lightbox.show {
            opacity: 1;
        }

        .lightbox-content {
            position: relative;
            width: 90%;
            max-width: 1000px;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
            border-radius: 12px;
            overflow: hidden;
            background: #000;
            transform: scale(0.95);
            transition: transform 0.3s ease;
        }

        #lightbox.show .lightbox-content {
            transform: scale(1);
        }

        #lightbox-img {
            width: 100%;
            max-height: 75vh;
            object-fit: contain;
            background: #000;
            display: block;
        }

        .lightbox-details {
            padding: 20px;
            background: #FFFFFF;
            border-top: 1px solid #eee;
        }

        /* Tombol Navigasi Lightbox */
        .lb-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            z-index: 10000;
        }

        .lb-btn:hover {
            background: #83C540;
            color: #003024;
            border-color: #83C540;
        }

        .lb-prev { left: 20px; }
        .lb-next { right: 20px; }

        .lb-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: transparent;
            color: white;
            border: none;
            font-size: 2rem;
            cursor: pointer;
            z-index: 10001;
            transition: transform 0.2s;
        }
        
        .lb-close:hover { transform: rotate(90deg); color: #83C540; }

        /* Media Query Mobile untuk navigasi lightbox */
        @media (max-width: 768px) {
            .lb-btn { width: 40px; height: 40px; font-size: 1rem; }
            .lb-prev { left: 10px; }
            .lb-next { right: 10px; }
            .img-wrapper { height: 200px; }
        }

        /* --- 5. ANIMATIONS KEYFRAMES --- */
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Utility class untuk animasi load awal */
        .animate-fade-in {
            opacity: 0;
            animation: fadeInUp 0.6s ease forwards;
        }
    </style>
</head>
<body>

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <div class="text-center mb-12 animate-fade-in" style="animation-delay: 0.1s;">
            <h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">Galeri Foto</h1>
            <p class="text-lg opacity-80 max-w-2xl mx-auto font-light">
                Dokumentasi kegiatan dan momen berharga perjalanan Bausasran.
            </p>
            <div style="height: 4px; width: 60px; background: #83C540; margin: 20px auto; border-radius: 2px;"></div>
        </div>

        <% if(groupFotoList && groupFotoList.length > 0) { %>
            <div class="filter-container">
                <button onclick="filterGaleri('all', this)" class="filter-btn active">Semua</button>
                <% groupFotoList.forEach(group => { %>
                    <button onclick="filterGaleri('<%= group.ID_GroupFoto %>', this)" class="filter-btn">
                        <%= group.Nama %>
                    </button>
                <% }) %>
            </div>
        <% } %>

        <% if(fotoList && fotoList.length > 0) { %>
            <div class="gallery-grid">
                <% fotoList.forEach((foto, index) => { %>
                    <div class="galeri-card animate-fade-in" 
                         style="animation-delay: <%= 0.2 + (index * 0.05) %>s"
                         data-category="<%= foto.ID_GroupFoto %>"
                         data-index="<%= index %>"
                         onclick="openLightbox(this.dataset.index)">
                        
                        <div class="img-wrapper">
                            <% 
                            let folder = 'anggota';
                            if (foto.dataValues.kategoriName) {
                                const k = foto.dataValues.kategoriName.toLowerCase();
                                if (k.includes('kegiatan')) folder = 'kegiatan';
                                else if (k.includes('produk')) folder = 'produk';
                                else if (k.includes('galeri')) folder = 'galeri';
                            }
                            %>
                            <img src="/images/<%= folder %>/<%= foto.Foto %>" alt="Foto" loading="lazy">
                            
                            <% if (foto.dataValues.kategoriName) { %>
                                <span class="badge-category"><%= foto.dataValues.kategoriName %></span>
                            <% } %>
                        </div>

                        <div class="card-body">
                            <% if (foto.Deskripsi) { %>
                                <div class="card-desc"><%= foto.Deskripsi %></div>
                            <% } %>
                            <% if (foto.Tanggal) { %>
                                <div class="card-date">
                                    <i class="far fa-calendar-alt"></i>
                                    <%= new Date(foto.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 text-gray-400 animate-fade-in">
                <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;">
                    <i class="fas fa-images"></i>
                </div>
                <h3 class="text-2xl font-semibold mb-2" style="color:white">Belum Ada Foto</h3>
                <p>Galeri akan segera diupdate dengan dokumentasi terbaru.</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script type="application/json" id="foto-data">
        <%- JSON.stringify(fotoList || []) %>
    </script>

    <div id="lightbox">
        <button class="lb-close" onclick="closeLightbox()">&times;</button>
        
        <button class="lb-btn lb-prev" onclick="navigateLightbox(-1); event.stopPropagation()">
            <i class="fas fa-chevron-left"></i>
        </button>

        <div class="lightbox-content" onclick="event.stopPropagation()">
            <img id="lightbox-img" src="" alt="Preview">
            <div class="lightbox-details">
                <p id="lightbox-desc" style="color: #111; font-weight: 700; font-size: 1.1rem; margin: 0;"></p>
                <p id="lightbox-date" style="color: #666; font-size: 0.9rem; margin: 5px 0 0 0; display:flex; align-items:center; gap:5px;">
                    <i class="far fa-calendar"></i> <span></span>
                </p>
            </div>
        </div>

        <button class="lb-btn lb-next" onclick="navigateLightbox(1); event.stopPropagation()">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>

    <script>
        let currentImageIndex = 0;
        let fotoData = [];
        
        // --- 1. Load Data ---
        try {
            const dataElement = document.getElementById('foto-data');
            if (dataElement && dataElement.textContent) {
                fotoData = JSON.parse(dataElement.textContent);
            }
        } catch (e) { console.error("Error parsing gallery data:", e); }

        // --- 2. Filter Function dengan Animasi ---
        function filterGaleri(category, btnElement) {
            // Update tombol aktif
            const buttons = document.querySelectorAll('.filter-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            if(btnElement) btnElement.classList.add('active');

            const items = document.querySelectorAll('.galeri-card');
            
            items.forEach(item => {
                const match = (category === 'all' || item.dataset.category === category);
                
                if (match) {
                    // Jika cocok, hilangkan display none dulu
                    if(item.classList.contains('hidden-item')) {
                        item.classList.remove('hidden-item');
                        // Beri sedikit delay agar transisi opacity berjalan
                        setTimeout(() => {
                            item.classList.remove('anim-out');
                        }, 50);
                    } else {
                        // Jika sudah ada, pastikan terlihat
                        item.classList.remove('anim-out');
                    }
                } else {
                    // Jika tidak cocok, animasikan keluar dulu
                    item.classList.add('anim-out');
                    // Tunggu animasi CSS selesai (0.4s) baru display none
                    setTimeout(() => {
                        // Cek lagi apakah statusnya masih harus hidden (untuk menghindari race condition jika user klik cepat)
                        if(item.classList.contains('anim-out')){
                            item.classList.add('hidden-item');
                        }
                    }, 400); 
                }
            });
        }

        // --- 3. Lightbox Logic ---
        function openLightbox(index) {
            currentImageIndex = parseInt(index); 
            updateLightboxContent();
            
            const lightbox = document.getElementById('lightbox');
            lightbox.style.display = 'flex';
            
            // Trigger reflow agar transisi opacity berjalan
            void lightbox.offsetWidth; 
            lightbox.classList.add('show');
            
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.remove('show');
            
            // Tunggu transisi selesai baru display none
            setTimeout(() => {
                lightbox.style.display = 'none';
                document.body.style.overflow = 'auto';
            }, 300);
        }

        function navigateLightbox(direction) {
            if (fotoData.length === 0) return;
            // Gunakan modulo untuk infinite loop
            currentImageIndex = (currentImageIndex + direction + fotoData.length) % fotoData.length;
            
            // Efek fade ganti gambar sederhana
            const imgElement = document.getElementById('lightbox-img');
            imgElement.style.opacity = '0.5';
            
            setTimeout(() => {
                updateLightboxContent();
                imgElement.style.opacity = '1';
            }, 150);
        }

        function updateLightboxContent() {
            if (!fotoData || fotoData.length === 0) return;
            const foto = fotoData[currentImageIndex];
            
            let folder = 'anggota';
            if (foto.dataValues && foto.dataValues.kategoriName) {
                const k = foto.dataValues.kategoriName.toLowerCase();
                if (k.includes('kegiatan')) folder = 'kegiatan';
                else if (k.includes('produk')) folder = 'produk';
                else if (k.includes('galeri')) folder = 'galeri';
            }
            
            const imgEl = document.getElementById('lightbox-img');
            imgEl.src = `/images/${folder}/${foto.Foto}`;
            
            document.getElementById('lightbox-desc').textContent = foto.Deskripsi || 'Tanpa Deskripsi';
            
            const dateEl = document.querySelector('#lightbox-date span');
            if (foto.Tanggal) {
                dateEl.textContent = new Date(foto.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
                document.getElementById('lightbox-date').style.display = 'flex';
            } else {
                document.getElementById('lightbox-date').style.display = 'none';
            }
        }
        
        // --- 4. Event Listeners ---
        
        // Tutup lightbox jika klik area gelap di luar gambar
        document.getElementById('lightbox').addEventListener('click', (e) => {
            if(e.target.id === 'lightbox') {
                closeLightbox();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (document.getElementById('lightbox').style.display === 'flex') {
                if (e.key === 'ArrowLeft') navigateLightbox(-1);
                if (e.key === 'ArrowRight') navigateLightbox(1);
                if (e.key === 'Escape') closeLightbox();
            }
        });
    </script>
</body>
</html>
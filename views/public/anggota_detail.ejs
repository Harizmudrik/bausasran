<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= anggota.Nama %> - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* --- 1. GLOBAL THEME --- */
        body {
            background-color: #003024 !important;
            min-height: 100vh;
            font-family: 'Segoe UI', Roboto, sans-serif;
            color: #FFFFFF;
        }

        /* Pattern Background Halus */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(circle at 20% 80%, rgba(131, 197, 64, 0.05) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        main {
            position: relative;
            z-index: 1;
        }

        /* --- 2. BREADCRUMB --- */
        .breadcrumb-nav {
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }
        .breadcrumb-item a {
            color: #ccc;
            text-decoration: none;
            transition: color 0.2s;
        }
        .breadcrumb-item a:hover {
            color: #83C540;
        }
        .breadcrumb-separator {
            color: #666;
            margin: 0 8px;
        }
        .breadcrumb-current {
            color: #83C540;
            font-weight: 600;
        }

        /* --- 3. PROFILE CARD --- */
        .profile-card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @media (min-width: 768px) {
            .profile-card {
                flex-direction: row;
                min-height: 450px;
            }
        }

        /* Left Side (Photo) */
        .profile-sidebar {
            flex: 1;
            background-color: #f3f4f6;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            min-height: 300px; /* Mobile height */
        }

        .profile-sidebar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .profile-sidebar:hover img {
            transform: scale(1.05);
        }

        /* Fallback Avatar */
        .avatar-fallback {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #003024 0%, #004d3a 100%);
            color: rgba(255,255,255,0.15);
            font-size: 8rem;
            font-weight: 800;
            position: absolute;
            inset: 0;
        }

        /* Right Side (Info) */
        .profile-content {
            flex: 2;
            padding: 40px;
            color: #333; /* Dark text inside white card */
            display: flex;
            flex-direction: column;
        }

        /* Header Info */
        .profile-header {
            margin-bottom: 30px;
            border-bottom: 1px solid #eee;
            padding-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 10px;
        }

        .profile-name {
            font-size: 2.5rem;
            font-weight: 800;
            color: #111;
            line-height: 1.1;
            margin-bottom: 5px;
        }

        .profile-role-badge {
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-admin { background: #8b5cf6; color: white; }
        .badge-user { background: #83C540; color: #003024; }

        .profile-jabatan {
            font-size: 1.2rem;
            color: #83C540; /* Warna aksen hijau */
            font-weight: 600;
        }

        /* Details List */
        .info-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 15px;
            font-size: 1rem;
            color: #4b5563;
        }

        .info-icon {
            width: 24px;
            color: #83C540;
            margin-right: 12px;
            margin-top: 4px; /* Align with text top */
        }

        .info-label {
            font-weight: 600;
            color: #1f2937;
            margin-right: 5px;
            min-width: 90px;
        }

        /* Bio Section */
        .bio-section {
            margin-top: 30px;
            padding: 20px;
            background: #f9fafb;
            border-radius: 12px;
            border-left: 4px solid #83C540;
        }

        /* Buttons */
        .action-buttons {
            margin-top: auto; /* Push to bottom */
            padding-top: 30px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn-wa {
            background-color: #25D366;
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
            box-shadow: 0 4px 10px rgba(37, 211, 102, 0.3);
        }
        .btn-wa:hover {
            background-color: #1ebc57;
            transform: translateY(-2px);
        }

        .btn-back {
            background-color: #e5e7eb;
            color: #374151;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }
        .btn-back:hover {
            background-color: #d1d5db;
            color: #111;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <nav class="breadcrumb-nav">
            <span class="breadcrumb-item"><a href="/">Home</a></span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-item"><a href="/anggota">Tim</a></span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-item breadcrumb-current"><%= anggota.Nama %></span>
        </nav>

        <div class="max-w-6xl mx-auto">
            <div class="profile-card">
                
                <div class="profile-sidebar">
                    <% if (anggota.dataValues.fotoFile) { %>
                        <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                             alt="<%= anggota.Nama %>"
                             onerror="this.style.display='none'; document.getElementById('fallback-<%= anggota.ID_Pengguna %>').style.display='flex'">
                        
                        <div id="fallback-<%= anggota.ID_Pengguna %>" class="avatar-fallback" style="display:none;">
                            <%= anggota.Nama.charAt(0).toUpperCase() %>
                        </div>
                    <% } else { %>
                        <div class="avatar-fallback">
                            <%= anggota.Nama.charAt(0).toUpperCase() %>
                        </div>
                    <% } %>
                </div>

                <div class="profile-content">
                    
                    <div class="profile-header">
                        <div>
                            <h1 class="profile-name"><%= anggota.Nama %></h1>
                            <% if (anggota.Jabatan) { %>
                                <p class="profile-jabatan"><%= anggota.Jabatan %></p>
                            <% } %>
                        </div>
                        <span class="profile-role-badge <%= anggota.Role === 'Admin' ? 'badge-admin' : 'badge-user' %>">
                            <%= anggota.Role %>
                        </span>
                    </div>

                    <ul class="info-list">
                        <% if (anggota.username) { %>
                            <li class="info-item">
                                <i class="fas fa-user-circle info-icon"></i>
                                <div>
                                    <span class="info-label">Username:</span>
                                    <%= anggota.username %>
                                </div>
                            </li>
                        <% } %>
                        
                        <% if (anggota.No_Telepon) { %>
                            <li class="info-item">
                                <i class="fas fa-phone-alt info-icon"></i>
                                <div>
                                    <span class="info-label">Telepon:</span>
                                    <%= anggota.No_Telepon %>
                                </div>
                            </li>
                        <% } %>

                        <% if (anggota.Alamat) { %>
                            <li class="info-item">
                                <i class="fas fa-map-marker-alt info-icon"></i>
                                <div>
                                    <span class="info-label">Alamat:</span>
                                    <%= anggota.Alamat %>
                                </div>
                            </li>
                        <% } %>

                        <% if (anggota.TanggalBergabung) { %>
                            <li class="info-item">
                                <i class="far fa-calendar-alt info-icon"></i>
                                <div>
                                    <span class="info-label">Bergabung:</span>
                                    <%= new Date(anggota.TanggalBergabung).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </div>
                            </li>
                        <% } %>
                    </ul>

                    <% if (anggota.Bio || anggota.Keterangan) { %>
                        <div class="bio-section">
                            <h3 class="text-lg font-bold mb-2 text-gray-800">Tentang</h3>
                            <p class="text-gray-600 leading-relaxed whitespace-pre-line"><%= anggota.Bio || anggota.Keterangan %></p>
                        </div>
                    <% } %>

                    <div class="action-buttons">
                        <% if (anggota.No_Telepon) { %>
                            <a href="https://wa.me/<%= anggota.No_Telepon.replace(/[^0-9]/g, '') %>?text=Halo%20<%= encodeURIComponent(anggota.Nama) %>" 
                               target="_blank"
                               class="btn-wa">
                                <i class="fab fa-whatsapp fa-lg"></i>
                                Hubungi via WhatsApp
                            </a>
                        <% } %>
                        
                        <a href="/anggota" class="btn-back">
                            <i class="fas fa-arrow-left"></i>
                            Kembali
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

</body>
</html>